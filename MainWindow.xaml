<Window x:Class="WinBatLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinBat Lens - Windows 電池健康度與即時硬體耗電監測" 
        Height="920" Width="1280" MinHeight="750" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextMain}"
        Icon="app_icon.png">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" 
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                CornerRadius="14" Padding="20,16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="10" Background="Transparent" Margin="0,0,12,0">
                        <Image Source="app_icon.png" Width="40" Height="40"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WinBat Lens" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                        <TextBlock x:Name="TxtSystemModel" Text="Windows 電池健康診斷與全系統耗電監測" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Auto Startup Toggle CheckBox -->
                    <CheckBox x:Name="ChkAutoStart" Content="🚀 開機自動啟動" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand" Click="ChkAutoStart_Click"/>

                    <Button x:Name="BtnOpenReport" Content="📁 開啟 HTML 報告" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="BtnOpenReport_Click"/>
                    <Button x:Name="BtnGenerateReport" Content="⚡ 執行電池檢測" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Click="BtnGenerateReport_Click"/>
                    <Button x:Name="BtnExportData" Content="📥 匯出 JSON" Style="{StaticResource SecondaryButtonStyle}" Click="BtnExportData_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dashboard Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0" Padding="0,0,8,20">
                <StackPanel>
                    
                    <!-- Health Gauge Card -->
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" 
                            BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="電池健康度 (Health Score)" FontSize="13" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            
                            <!-- Large Health Score Ring / Value -->
                            <Grid Margin="0,16">
                                <Ellipse Width="140" Height="140" Stroke="#1E293B" StrokeThickness="12"/>
                                <Ellipse x:Name="RingHealthProgress" Width="140" Height="140" Stroke="{StaticResource AccentEmerald}" StrokeThickness="12" StrokeDashArray="440" StrokeDashOffset="440"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtHealthPercent" Text="--" FontSize="40" FontWeight="ExtraBold" Foreground="{StaticResource TextMain}"/>
                                        <TextBlock Text="%" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="2,0,0,8"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Status Badge -->
                            <Border x:Name="BadgeStatus" CornerRadius="16" Background="#2010B981" BorderBrush="{StaticResource AccentEmerald}" BorderThickness="1" Padding="14,4" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtStatusLabel" Text="--" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentEmerald}"/>
                            </Border>

                            <TextBlock x:Name="TxtSummary" Text="請點擊右上角「執行電池檢測」按鈕載入最新報告。" 
                                       FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Battery Specs Card -->
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" 
                            BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🔋 電池規格參數" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,14"/>
                            
                            <Grid Margin="0,4">
                                <TextBlock Text="電池名稱" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                                <TextBlock x:Name="TxtSpecName" Text="--" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Background="#10FFFFFF" Margin="0,6"/>

                            <Grid Margin="0,4">
                                <TextBlock Text="製造商" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                                <TextBlock x:Name="TxtSpecMfg" Text="--" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Background="#10FFFFFF" Margin="0,6"/>

                            <Grid Margin="0,4">
                                <TextBlock Text="化學材質" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                                <TextBlock x:Name="TxtSpecChem" Text="--" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Background="#10FFFFFF" Margin="0,6"/>

                            <Grid Margin="0,4">
                                <TextBlock Text="設計容量" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                                <TextBlock x:Name="TxtSpecDesign" Text="-- mWh" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Background="#10FFFFFF" Margin="0,6"/>

                            <Grid Margin="0,4">
                                <TextBlock Text="滿電容量" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                                <TextBlock x:Name="TxtSpecFull" Text="-- mWh" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Background="#10FFFFFF" Margin="0,6"/>

                            <Grid Margin="0,4">
                                <TextBlock Text="容量損耗" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                                <TextBlock x:Name="TxtSpecLoss" Text="-- mWh" Foreground="{StaticResource AccentRose}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Background="#10FFFFFF" Margin="0,6"/>

                            <Grid Margin="0,4">
                                <TextBlock Text="充放電循環" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                                <TextBlock x:Name="TxtSpecCycles" Text="-- 次" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="260"/>
                </Grid.RowDefinitions>

                <!-- TOP SECTION: Tabs & Real-Time Power Monitor (Row 0) -->
                <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" 
                        BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                    <TabControl Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}">
                        
                        <!-- TAB 1: Full System Real-Time Power Monitor -->
                        <TabItem Header=" ⚡ 全系統硬體功耗分佈 ">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                <StackPanel>
                                    <!-- Power Discharge & Time Cards -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Live Discharge Rate Card -->
                                        <Border Grid.Column="0" Background="#182338" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="⚡ 電池總放電 / 充電功率" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock x:Name="TxtLiveDischargeRate" Text="-- W" FontSize="30" FontWeight="ExtraBold" Foreground="{StaticResource AccentCyan}" Margin="0,6"/>
                                                <Border x:Name="BadgeLiveAcState" Background="#2038BDF8" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" CornerRadius="12" Padding="10,3" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="TxtLiveAcState" Text="電源狀態讀取中..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Live Remaining Battery Time Card -->
                                        <Border Grid.Column="1" Background="#182338" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="⏱️ 電腦估算剩餘續航時間" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock x:Name="TxtLiveRemainingTime" Text="--" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentEmerald}" Margin="0,8"/>
                                                <TextBlock x:Name="TxtLiveBatteryPercent" Text="目前電量: --%" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Hardware Resource Load Breakdown Card -->
                                    <Border Background="#182338" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="💻 全系統各硬體元件功耗明細 (Full System Hardware Power Breakdown)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,14"/>

                                            <!-- CPU Usage & Power -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="🔲 CPU 處理器" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock x:Name="TxtCpuPowerW" Text="~0.0 W" Foreground="{StaticResource AccentCyan}" FontSize="11"/>
                                                </StackPanel>
                                                <ProgressBar x:Name="PbCpuUsage" Grid.Column="1" Height="12" Value="0" Maximum="100" Foreground="{StaticResource AccentCyan}" Background="#090D16" BorderThickness="0" Margin="10,0"/>
                                                <TextBlock x:Name="TxtCpuUsageVal" Grid.Column="2" Text="0%" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Discrete GPU (dGPU) Usage & Power -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtDgpuName" Text="🎮 獨立顯示卡 (dGPU)" Foreground="{StaticResource TextMain}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="TxtDgpuPowerW" Text="~0.0 W" Foreground="{StaticResource AccentAmber}" FontSize="11"/>
                                                </StackPanel>
                                                <ProgressBar x:Name="PbDgpuUsage" Grid.Column="1" Height="12" Value="0" Maximum="100" Foreground="{StaticResource AccentAmber}" Background="#090D16" BorderThickness="0" Margin="10,0"/>
                                                <TextBlock x:Name="TxtDgpuUsageVal" Grid.Column="2" Text="0% (待機省電)" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Integrated GPU (iGPU) Usage & Power -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtIgpuName" Text="🖼️ 內建顯示晶片 (iGPU)" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="TxtIgpuPowerW" Text="~0.0 W" Foreground="{StaticResource AccentCyan}" FontSize="11"/>
                                                </StackPanel>
                                                <ProgressBar x:Name="PbIgpuUsage" Grid.Column="1" Height="12" Value="0" Maximum="100" Foreground="{StaticResource AccentCyan}" Background="#090D16" BorderThickness="0" Margin="10,0"/>
                                                <TextBlock x:Name="TxtIgpuUsageVal" Grid.Column="2" Text="0%" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Screen Display & Backlight Power -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="🖥️ 螢幕面板與背光" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock x:Name="TxtScreenPowerW" Text="~0.0 W" Foreground="{StaticResource AccentRose}" FontSize="11"/>
                                                </StackPanel>
                                                <ProgressBar x:Name="PbScreenBrightness" Grid.Column="1" Height="12" Value="0" Maximum="100" Foreground="{StaticResource AccentRose}" Background="#090D16" BorderThickness="0" Margin="10,0"/>
                                                <TextBlock x:Name="TxtScreenBrightnessVal" Grid.Column="2" Text="75% 亮度" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Wi-Fi Wireless Adapter & Traffic Power -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="📶 Wi-Fi / 藍牙網絡" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock x:Name="TxtWifiPowerW" Text="~0.0 W" Foreground="{StaticResource AccentCyan}" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                    <TextBlock x:Name="TxtWifiSpeedVal" Text="即時傳輸流量: 0 KB/s" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                </StackPanel>
                                                <TextBlock Text="無線網卡運作中" Grid.Column="2" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Disk (SSD/HDD) Usage & Power -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="💾 硬碟 (SSD/HDD)" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock x:Name="TxtDiskPowerW" Text="~0.0 W" Foreground="{StaticResource AccentEmerald}" FontSize="11"/>
                                                </StackPanel>
                                                <ProgressBar x:Name="PbDiskUsage" Grid.Column="1" Height="12" Value="0" Maximum="100" Foreground="{StaticResource AccentEmerald}" Background="#090D16" BorderThickness="0" Margin="10,0"/>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtDiskUsageVal" Text="0%" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                                                    <TextBlock x:Name="TxtDiskStatusText" Text="0 MB/s" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- RAM Usage & Power -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="🧠 記憶體 (RAM) 匯流排" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock x:Name="TxtRamPowerW" Text="~0.0 W" Foreground="{StaticResource AccentPurple}" FontSize="11"/>
                                                </StackPanel>
                                                <ProgressBar x:Name="PbRamUsage" Grid.Column="1" Height="12" Value="0" Maximum="100" Foreground="{StaticResource AccentPurple}" Background="#090D16" BorderThickness="0" Margin="10,0"/>
                                                <TextBlock x:Name="TxtRamUsageVal" Grid.Column="2" Text="0 GB / 0 GB" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Motherboard Base Power -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="🔌 主機板與 USB 外設" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock x:Name="TxtMotherboardPowerW" Text="~2.5 W" Foreground="{StaticResource TextDim}" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="基板晶片組、音訊與週邊匯流排基礎功耗" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
                                                <TextBlock Text="晶片組運作中" Grid.Column="2" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <Separator Background="#10FFFFFF" Margin="0,10"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="全系統功耗評級: " Foreground="{StaticResource TextMuted}" FontSize="13"/>
                                                <TextBlock x:Name="TxtPowerLoadStatus" Text="輕度省電" Foreground="{StaticResource AccentEmerald}" FontWeight="Bold" FontSize="13" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Discrete GPU Hardware Specs List Card -->
                                    <Border Background="#182338" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="🎮 系統顯示卡清單 (Graphics Hardware List)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,12"/>

                                            <ItemsControl x:Name="IcGpuList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#0C1322" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0">
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextMain}"/>
                                                                        <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="10" Background="#20F59E0B" BorderBrush="{StaticResource AccentAmber}" BorderThickness="1">
                                                                            <TextBlock Text="{Binding GpuTypeTag}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentAmber}"/>
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                        <TextBlock Text="專屬視訊記憶體: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                                        <TextBlock Text="{Binding VramText}" Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold" FontSize="12" Margin="4,0,16,0"/>

                                                                        <TextBlock Text="驅動版本: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                                        <TextBlock Text="{Binding DriverVersion}" Foreground="{StaticResource TextMain}" FontSize="12" Margin="4,0,16,0"/>

                                                                        <TextBlock Text="發布日期: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                                        <TextBlock Text="{Binding DriverDate}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="4,0,0,0"/>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource AccentEmerald}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Live Power Tip Box -->
                                    <Border Background="#1038BDF8" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <TextBlock x:Name="TxtLivePowerTip" Text="💡 即時監測每 1 秒自動更新一次 CPU、獨顯、內顯、螢幕背光、Wi-Fi、磁碟與記憶體功耗。" FontSize="12" Foreground="{StaticResource TextMain}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 2: Smart Diagnostics -->
                        <TabItem Header=" 💡 智慧診斷與維護建議 ">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                <ItemsControl x:Name="IcDiagnostics">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#182338" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="{StaticResource AccentCyan}" BorderThickness="4,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextMain}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 3: Life Estimates -->
                        <TabItem Header=" ⏱️ 續航估算表 ">
                            <ListView x:Name="LvLifeEstimates" Background="#0C1322" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Foreground="{StaticResource TextMain}" Margin="0,12,0,0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="記錄期間" Width="220" DisplayMemberBinding="{Binding Period}"/>
                                        <GridViewColumn Header="實測滿電續航" Width="220" DisplayMemberBinding="{Binding FullChargeEstimate}"/>
                                        <GridViewColumn Header="原廠設計續航" Width="220" DisplayMemberBinding="{Binding DesignCapEstimate}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </TabItem>

                        <!-- TAB 4: Recent Usage -->
                        <TabItem Header=" 📊 最近使用紀錄 ">
                            <ListView x:Name="LvRecentUsage" Background="#0C1322" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Foreground="{StaticResource TextMain}" Margin="0,12,0,0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="開始時間" Width="220" DisplayMemberBinding="{Binding StartTime}"/>
                                        <GridViewColumn Header="狀態" Width="140" DisplayMemberBinding="{Binding State}"/>
                                        <GridViewColumn Header="電源來源" Width="140" DisplayMemberBinding="{Binding Source}"/>
                                        <GridViewColumn Header="剩餘電量" Width="160" DisplayMemberBinding="{Binding CapacityRemaining}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </TabItem>

                    </TabControl>
                </Border>

                <!-- BOTTOM SECTION: Capacity History Section (Row 1) -->
                <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" 
                        BorderThickness="1" CornerRadius="14" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="📈 容量歷史數據紀錄 (Capacity Degradation History)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                            <TextBlock x:Name="TxtReportTime" Text="尚未載入" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <ListView x:Name="LvCapacityHistory" Grid.Row="1" Background="#0C1322" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Foreground="{StaticResource TextMain}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="記錄期間" Width="200" DisplayMemberBinding="{Binding Period}"/>
                                    <GridViewColumn Header="實測滿電容量" Width="180" DisplayMemberBinding="{Binding FullChargeCapacity}"/>
                                    <GridViewColumn Header="原廠設計容量" Width="180" DisplayMemberBinding="{Binding DesignCapacity}"/>
                                    <GridViewColumn Header="健康度 (%)" Width="140" DisplayMemberBinding="{Binding HealthPercent}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- Loading Overlay -->
        <Border x:Name="OverlayLoading" Grid.RowSpan="2" Background="#D0090D16" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⚡" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <TextBlock Text="正在執行 Windows 電池健康檢測 (powercfg /batteryreport)..." FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
                <TextBlock Text="請稍候..." FontSize="13" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
