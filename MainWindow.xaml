<Window x:Class="WinBatLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinBatLens"
        mc:Ignorable="d"
        Title="WinBat Lens" Height="800" Width="1240" MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextMain}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft JhengHei UI, sans-serif"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/app_icon.png">

    <Window.Resources>
        <!-- Loading Spinner Rotation Animation -->
        <Storyboard x:Key="StoryboardLoadingSpinner" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.1"/>
        </Storyboard>

        <!-- Dynamic Energy Flow Storyboards -->
        <!-- Charging: AC particle moves into hub, Hub particle moves into Battery vessel, Battery liquid shimmers -->
        <Storyboard x:Key="StoryboardEnergyFlowCharging" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="FlowAcTranslate"
                             Storyboard.TargetProperty="X"
                             From="-15" To="35" Duration="0:0:1.2"/>
            <DoubleAnimation Storyboard.TargetName="FlowBatteryTranslate"
                             Storyboard.TargetProperty="X"
                             From="-20" To="80" Duration="0:0:1.2"/>
            <DoubleAnimation Storyboard.TargetName="FlowShimmerTranslate"
                             Storyboard.TargetProperty="X"
                             From="-40" To="180" Duration="0:0:1.8"/>
        </Storyboard>

        <!-- Discharging: Battery particle flows out towards system hub -->
        <Storyboard x:Key="StoryboardEnergyFlowDischarging" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="FlowBatteryTranslate"
                             Storyboard.TargetProperty="X"
                             From="80" To="-20" Duration="0:0:1.2"/>
        </Storyboard>

        <!-- Idle on AC: Slow gentle AC connection pulse -->
        <Storyboard x:Key="StoryboardEnergyFlowIdle" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="FlowAcTranslate"
                             Storyboard.TargetProperty="X"
                             From="-15" To="35" Duration="0:0:2.0"/>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="14" x:Name="RootLayoutGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="EntranceTransform" Y="0"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- TOP HEADER BAR                                               -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}"
                Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Brand & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8"
                            Background="{StaticResource BgInset}"
                            BorderBrush="{StaticResource BorderStrong}"
                            BorderThickness="1" Margin="0,0,12,0">
                        <Image Source="pack://application:,,,/app_icon.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeaderAppTitle" Text="WinBat Lens" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                            <!-- Version badge -->
                            <Border x:Name="BadgeAppVersion" Style="{StaticResource StatusPillStyle}"
                                    Background="{StaticResource BgControl}"
                                    BorderBrush="{StaticResource BorderStrong}"
                                    Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtAppVersion" Text="v1.1.2" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBright}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtSystemModel" Text="Windows 電池健康診斷與全系統耗電監測" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions Header Bar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Language Switcher Button -->
                    <Button x:Name="BtnLanguageToggle" Tag="{StaticResource GeoIconGlobe}" Content="English" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,4" Click="BtnLanguageToggle_Click"/>

                    <!-- Auto Startup Toggle CheckBox -->
                    <CheckBox x:Name="ChkAutoStart" Content="開機自動啟動" VerticalAlignment="Center" Margin="0,0,14,0" Click="ChkAutoStart_Click"/>

                    <Button x:Name="BtnOpenReport" Tag="{StaticResource GeoIconFileReport}" Content="開啟 HTML 報告" Style="{StaticResource HeaderIconButtonStyle}" Margin="0,0,6,0" Click="BtnOpenReport_Click"/>
                    <Button x:Name="BtnGenerateReport" Tag="{StaticResource GeoIconRefresh}" Content="執行電池檢測" Style="{StaticResource HeaderPrimaryIconButtonStyle}" Margin="0,0,6,0" Click="BtnGenerateReport_Click"/>
                    <Button x:Name="BtnExportData" Tag="{StaticResource GeoIconExport}" Content="匯出 JSON" Style="{StaticResource HeaderIconButtonStyle}" Click="BtnExportData_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- DASHBOARD MAIN BODY                                          -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="385"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- LEFT PANEL: Battery Health, Specs, & Degradation History -->
            <!-- ======================================================== -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Cybernetic Dual-Ring Health Meter Card -->
                <Border Grid.Row="0" Style="{StaticResource HeroCardStyle}"
                        Padding="14,12" Margin="0,0,0,9">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Header with Shield Icon -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <Path Data="{StaticResource GeoIconShieldCheck}" Fill="{StaticResource AccentCyan}"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtHealthCardTitle" Text="電池健康度 (Health Score)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                        </StackPanel>

                        <!-- Large Precision Dual-Ring Health Gauge -->
                        <Grid Margin="0,6" Width="120" Height="120">
                            <!-- Outer Decorative Tick Ring -->
                            <Ellipse Width="116" Height="116" Stroke="#2038BDF8" StrokeThickness="1.5" StrokeDashArray="2,4"/>
                            <!-- Background Track -->
                            <Ellipse Width="102" Height="102" Stroke="{StaticResource BgControl}" StrokeThickness="9"/>
                            <!-- Progress Arc -->
                            <Ellipse x:Name="RingHealthProgress" Width="102" Height="102" Stroke="{StaticResource HealthGood}" StrokeThickness="9" StrokeDashArray="0,1000" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- Center Digital Readout -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtHealthPercent" Text="--" FontSize="30" FontWeight="ExtraBold" Foreground="{StaticResource TextMain}" Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock x:Name="TxtHealthPercentSign" Text="%" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="1,0,0,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Status Badge -->
                        <Border x:Name="BadgeStatus" Style="{StaticResource StatusPillStyle}" Background="#2034D399" BorderBrush="{StaticResource HealthGood}" HorizontalAlignment="Center" Padding="14,3">
                            <TextBlock x:Name="TxtStatusLabel" Text="--" FontWeight="Bold" FontSize="11" Foreground="{StaticResource HealthGood}"/>
                        </Border>

                        <TextBlock x:Name="TxtSummary" Text="請點擊右上角「執行電池檢測」按鈕載入最新報告。"
                                   FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0" LineHeight="15"/>
                    </StackPanel>
                </Border>

                <!-- 2. Battery Capacity & Degradation Graphic Comparison Card -->
                <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}"
                        Padding="14,10" Margin="0,0,0,9">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource GeoIconBattery}" Fill="{StaticResource AccentCyan}"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBatterySpecsTitle" Text="電池規格與容量損耗圖" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                        </StackPanel>

                        <!-- Visual Capacity Loss Tank Diagram -->
                        <Border Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock x:Name="LblSpecDesign" Text="原廠設計容量" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="TxtSpecDesign" Text="-- mWh" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                                <!-- Design Capacity Full Reference Bar -->
                                <Border Height="6" Background="{StaticResource BgDark}" CornerRadius="3" Margin="0,0,0,6">
                                    <Border Background="#4038BDF8" CornerRadius="3"/>
                                </Border>

                                <Grid Margin="0,2,0,4">
                                    <TextBlock x:Name="LblSpecFull" Text="實測滿電 vs 容量損耗" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="TxtSpecFull" Text="-- mWh" Foreground="{StaticResource AccentCyanBright}" FontWeight="Bold" FontSize="11" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Visual Segmented Dual-Bar (Full Capacity + Hatched Loss Zone) -->
                                <Grid Height="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ColVisualFullCap" Width="*"/>
                                        <ColumnDefinition x:Name="ColVisualLossCap" Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Full Charge Bar Segment -->
                                    <Border x:Name="BarVisualFullCharge" Grid.Column="0" Background="{StaticResource HealthGood}" CornerRadius="4,0,0,4" Margin="0,0,1,0"/>
                                    <!-- Loss Zone Striped Segment -->
                                    <Border x:Name="BarVisualLossZone" Grid.Column="1" Width="60" Background="{StaticResource LossHatchBrush}" BorderBrush="{StaticResource PowerDischarge}" BorderThickness="1" CornerRadius="0,4,4,0"/>
                                </Grid>

                                <!-- Loss Metric Tag -->
                                <Grid Margin="0,4,0,0">
                                    <TextBlock x:Name="LblSpecLoss" Text="損耗規模" Foreground="{StaticResource PowerDischarge}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtSpecLoss" Text="-- mWh" Foreground="{StaticResource PowerDischarge}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4 Quick Hardware Specs Tiles -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Tile 1: Model & Mfg -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,3,4">
                                <StackPanel>
                                    <TextBlock x:Name="LblSpecMfg" Text="製造商" Foreground="{StaticResource TextDim}" FontSize="10"/>
                                    <TextBlock x:Name="TxtSpecMfg" Text="--" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtSpecName" Text="--" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    <TextBlock x:Name="LblSpecName" Text="電池名稱" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- Tile 2: Chemistry -->
                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="3,0,0,4">
                                <StackPanel>
                                    <TextBlock x:Name="LblSpecChem" Text="化學材質" Foreground="{StaticResource TextDim}" FontSize="10"/>
                                    <TextBlock x:Name="TxtSpecChem" Text="--" Foreground="{StaticResource AccentCyanBright}" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="Standard Pack" Foreground="{StaticResource TextDim}" FontSize="10"/>
                                </StackPanel>
                            </Border>

                            <!-- Tile 3: Cycles -->
                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,2,3,0">
                                <StackPanel>
                                    <TextBlock x:Name="LblSpecCycles" Text="充放電循環" Foreground="{StaticResource TextDim}" FontSize="10"/>
                                    <TextBlock x:Name="TxtSpecCycles" Text="-- 次" Foreground="{StaticResource TextMain}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <!-- Tile 4: Age / Manufacture Date -->
                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="3,2,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="LblSpecMade" Text="出廠年份/日期" Foreground="{StaticResource TextDim}" FontSize="10"/>
                                    <TextBlock x:Name="TxtSpecMade" Text="--" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <Grid x:Name="RowSpecMade" Visibility="Collapsed"/>
                                    <Separator x:Name="SepSpecMade" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Capacity Degradation History Card -->
                <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}"
                        Padding="13,10" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoIconChart}" Stroke="{StaticResource AccentCyan}" StrokeThickness="1.5"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCapacityHistoryTitle" Text="容量歷史紀錄" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtReportTime" Text="尚未載入" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Column Headers -->
                        <Border Grid.Row="1" Background="{StaticResource BgControl}" CornerRadius="6" Padding="8,5" Margin="0,0,14,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtColPeriod" Text="期間" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Grid.Column="0"/>
                                <TextBlock x:Name="TxtColFullCap" Text="滿電" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                                <TextBlock x:Name="TxtColDesignCap" Text="設計" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtColHealthPct" Text="健康%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Grid.Column="3" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                            </Grid>
                        </Border>

                        <!-- History Rows -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="LvCapacityHistory">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DataRowStyle}" Padding="7,5" Margin="0,0,0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="145"/>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Period}" FontSize="11" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" Grid.Column="0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FullChargeCapacity}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBright}" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1" Margin="0,0,5,0" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock Text="{Binding DesignCapacity}" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="2" Margin="0,0,6,0" Typography.NumeralAlignment="Tabular"/>
                                                <Border Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="999" Padding="6,1"
                                                        Background="{Binding HealthPercent, Converter={StaticResource HealthGradeBrush}, ConverterParameter=Badge}"
                                                        BorderBrush="{Binding HealthPercent, Converter={StaticResource HealthGradeBrush}}" BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding HealthPercent, StringFormat={}{0:F1}}" FontSize="11" FontWeight="Bold" Foreground="{Binding HealthPercent, Converter={StaticResource HealthGradeBrush}}" Typography.NumeralAlignment="Tabular"/>
                                                        <TextBlock Text="%" FontSize="10" Foreground="{Binding HealthPercent, Converter={StaticResource HealthGradeBrush}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- RIGHT PANEL: Full-Height Real-Time Monitoring & Detail   -->
            <!-- ======================================================== -->
            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Padding="12">
                <TabControl x:Name="TabMainControl" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}">

                    <!-- TAB 1: Real-Time Hardware Power Breakdown -->
                    <TabItem x:Name="TabRealTime" Tag="{StaticResource GeoIconBolt}" Header="全系統硬體功耗分佈">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>

                                <!-- ================================================= -->
                                <!-- 1. DYNAMIC POWER ARCHITECTURE SCHEMATIC HERO       -->
                                <!-- ================================================= -->
                                <Border Style="{StaticResource HeroCardStyle}" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Row: Interactive Full-System Schematic -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <!-- Node 1: AC Power Adapter -->
                                                <ColumnDefinition Width="120"/>
                                                <!-- Conduit 1: AC -> Hub -->
                                                <ColumnDefinition Width="32"/>
                                                <!-- Node 2: Power Distribution Hub -->
                                                <ColumnDefinition Width="185"/>
                                                <!-- Conduit 2: Hub -> Battery / GPU -->
                                                <ColumnDefinition Width="28"/>
                                                <!-- Node 3: Battery Vessel & Discrete GPU -->
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Node 1: AC Power Supply Adapter -->
                                            <Border Grid.Column="0" Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="8" Padding="8,10" VerticalAlignment="Stretch">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource BgControl}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                        <Path Data="{StaticResource GeoSchematicAdapter}" Fill="{StaticResource AccentCyan}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                                        <Ellipse x:Name="LedAcPower" Width="7" Height="7" Fill="{StaticResource PowerCharge}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="TxtSchematicAcState" Text="市電連接" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="AC Power Adapter" FontSize="9" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Conduit 1: Animated Particle Track (AC to Hub) -->
                                            <Border Grid.Column="1" Height="4" Background="{StaticResource BgDark}" CornerRadius="2" VerticalAlignment="Center" ClipToBounds="True">
                                                <Rectangle x:Name="RectAcFlowParticle" Width="14" Height="4" Fill="{StaticResource AccentCyanBright}" HorizontalAlignment="Left">
                                                    <Rectangle.RenderTransform>
                                                        <TranslateTransform x:Name="FlowAcTranslate" X="0"/>
                                                    </Rectangle.RenderTransform>
                                                </Rectangle>
                                            </Border>

                                            <!-- Node 2: Power Distribution Hub (Live Wattage) -->
                                            <Border Grid.Column="2" Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="8" Padding="10,10" VerticalAlignment="Stretch">
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Path Data="{StaticResource GeoSchematicChip}" Fill="{StaticResource AccentCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="TxtCardTotalPower" Text="電源調配中樞" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                                    </StackPanel>

                                                    <!-- Live Wattage with glowing halo -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,4">
                                                        <Border x:Name="BorderHeroIconGlow" Width="30" Height="30" CornerRadius="15"
                                                                Background="{StaticResource PowerDischargeTint}"
                                                                BorderBrush="{StaticResource PowerDischarge}"
                                                                BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Path x:Name="PathHeroFlowIcon" Data="{StaticResource GeoIconBolt}" Fill="{StaticResource PowerDischarge}"
                                                                  Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock x:Name="TxtLiveDischargeRate" Text="-- W" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource PowerDischarge}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <Border x:Name="BadgeLiveAcState" Style="{StaticResource StatusPillStyle}" Background="#20FB7185" BorderBrush="{StaticResource PowerDischarge}" HorizontalAlignment="Left" Padding="8,2">
                                                        <TextBlock x:Name="TxtLiveAcState" Text="電源狀態讀取中..." FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PowerDischarge}"/>
                                                    </Border>

                                                    <!-- Deficit Supply Verdict -->
                                                    <TextBlock x:Name="TxtLiveChargerSupply" Text="" FontSize="10" Foreground="{StaticResource PowerNeutral}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Conduit 2: Animated Particle Track (Hub to Battery & GPU) -->
                                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                                <Border Height="4" Background="{StaticResource BgDark}" CornerRadius="2" ClipToBounds="True">
                                                    <Rectangle x:Name="RectBatteryFlowParticle" Width="14" Height="4" Fill="{StaticResource PowerCharge}" HorizontalAlignment="Left">
                                                        <Rectangle.RenderTransform>
                                                            <TranslateTransform x:Name="FlowBatteryTranslate" X="0"/>
                                                        </Rectangle.RenderTransform>
                                                    </Rectangle>
                                                </Border>
                                            </Grid>

                                            <!-- Node 3: High-Tech 3D Battery Vessel & GPU Consumers -->
                                            <StackPanel Grid.Column="4">
                                                <!-- 3A. Dynamic 3D Glass Battery Vessel -->
                                                <Border Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,5">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,4">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource GeoSchematicBatteryVessel}" Fill="{StaticResource AccentCyan}" Width="15" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                                                <TextBlock x:Name="TxtLiveBatteryPercent" Text="電量 59.0%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMain}" Typography.NumeralAlignment="Tabular"/>
                                                            </StackPanel>
                                                            <TextBlock x:Name="TxtLiveBatteryWh" Text="32.7 / 55.4 Wh" FontSize="10" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                                        </Grid>

                                                        <!-- Glass Chamber Progress Bar -->
                                                        <Border Height="14" Background="{StaticResource BgDark}" CornerRadius="4" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" ClipToBounds="True">
                                                            <Grid>
                                                                <ProgressBar x:Name="PbHeroBattery" Height="14" Value="0" Maximum="100" Foreground="{StaticResource HealthGood}" Background="Transparent" BorderThickness="0"/>
                                                                <!-- Shimmer Fluid Animation -->
                                                                <Rectangle Width="35" Height="14" Fill="#35FFFFFF" HorizontalAlignment="Left">
                                                                    <Rectangle.RenderTransform>
                                                                        <TranslateTransform x:Name="FlowShimmerTranslate" X="-40"/>
                                                                    </Rectangle.RenderTransform>
                                                                </Rectangle>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 3B. Discrete GPU Die & Hardware Load -->
                                                <Border Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="8" Padding="10,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource GeoSchematicGpuDie}" Fill="{StaticResource PowerGpu}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="TxtDgpuName" Text="獨立顯示卡 (dGPU)" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <ProgressBar x:Name="PbDgpuUsage" Height="6" Value="0" Maximum="100" Foreground="{StaticResource PowerCharge}" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <TextBlock x:Name="TxtDgpuPowerW" Text="~0.0 W" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PowerGpu}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                                            <TextBlock x:Name="TxtDgpuUsageVal" Text="0% (待機)" FontSize="9" Foreground="{StaticResource PowerCharge}" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Bottom Row: 2 Companion Metric Instrument Tiles -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Companion Tile 1: Estimated Runtime -->
                                            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,5,0">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Path Data="{StaticResource GeoIconClock}" Fill="{StaticResource PowerNeutral}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="TxtCardEstTime" Text="電腦估算剩餘續航時間" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtLiveRemainingTime" Text="--" FontSize="21" FontWeight="Bold" Foreground="{StaticResource PowerNeutral}" Margin="0,2,0,2" Typography.NumeralAlignment="Tabular"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Companion Tile 2: Battery Telemetry & Temperature -->
                                            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="5,0,0,0">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Path Data="{StaticResource GeoIconVolt}" Fill="{StaticResource PowerDischarge}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="TxtCardTelemetry" Text="電池物理狀態 (電壓 / 電流)" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtLiveBatteryTelemetry" Text="-- V | -- A" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PowerDischarge}" Margin="0,2,0,2" Typography.NumeralAlignment="Tabular"/>
                                                    <TextBlock x:Name="TxtLiveBatteryTelemetrySub" Text="電池驅動實測" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- ================================================= -->
                                <!-- 2. 60-SECOND OSCILLOSCOPE WAVEFORM CHART          -->
                                <!-- ================================================= -->
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoIconChart}" Stroke="{StaticResource AccentCyan}" StrokeThickness="1.5"
                                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtWaveformTitle" Text="60 秒即時功率走勢示波器" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                            </StackPanel>

                                            <!-- Legend -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Width="10" Height="3" Background="{StaticResource PowerDischarge}" Margin="0,0,4,0" CornerRadius="1"/>
                                                <TextBlock x:Name="TxtLegendDischarge" Text="放電 (W)" FontSize="11" Foreground="{StaticResource PowerDischarge}" Margin="0,0,12,0"/>

                                                <Border Width="10" Height="3" Background="{StaticResource PowerCharge}" Margin="0,0,4,0" CornerRadius="1"/>
                                                <TextBlock x:Name="TxtLegendCharge" Text="充電 (+W)" FontSize="11" Foreground="{StaticResource PowerCharge}" Margin="0,0,12,0"/>

                                                <Border Width="10" Height="3" Background="{StaticResource PowerGpu}" Margin="0,0,4,0" CornerRadius="1"/>
                                                <TextBlock x:Name="TxtLegendGpu" Text="獨顯 (W)" FontSize="11" Foreground="{StaticResource PowerGpu}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Waveform Canvas Box with Y-Axis Coordinates & Area Glow -->
                                        <Border Height="146" Style="{StaticResource DataSurfaceStyle}" ClipToBounds="True">
                                            <Grid x:Name="GridChartContainer" SizeChanged="GridChartContainer_SizeChanged">
                                                <!-- Background Gridlines -->
                                                <Canvas x:Name="CanvasGridlines"/>

                                                <!-- Oscilloscope Translucent Area Fills -->
                                                <Polygon x:Name="PolygonAreaDischarge" Fill="{StaticResource WaveformDischargeAreaGradient}"/>
                                                <Polygon x:Name="PolygonAreaCharge" Fill="{StaticResource WaveformChargeAreaGradient}"/>
                                                <Polygon x:Name="PolygonAreaGpu" Fill="{StaticResource WaveformGpuAreaGradient}"/>

                                                <!-- Y-Axis Wattage Scale Labels Overlay -->
                                                <Grid VerticalAlignment="Stretch" HorizontalAlignment="Left" Margin="8,4,0,4" IsHitTestVisible="False">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock x:Name="TxtYAxis100" Grid.Row="0" Text="35 W (100%)" FontSize="10" Foreground="{StaticResource TextDim}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Top" Typography.NumeralAlignment="Tabular"/>
                                                    <TextBlock x:Name="TxtYAxis75" Grid.Row="1" Text="26 W (75%)" FontSize="10" Foreground="{StaticResource TextDim}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Top" Typography.NumeralAlignment="Tabular"/>
                                                    <TextBlock x:Name="TxtYAxis50" Grid.Row="2" Text="18 W (50%)" FontSize="10" Foreground="{StaticResource TextDim}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Top" Typography.NumeralAlignment="Tabular"/>
                                                    <TextBlock x:Name="TxtYAxis25" Grid.Row="3" Text="9 W (25%)" FontSize="10" Foreground="{StaticResource TextDim}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Top" Typography.NumeralAlignment="Tabular"/>
                                                    <TextBlock x:Name="TxtYAxis0" Grid.Row="4" Text="0 W (0%)" FontSize="10" Foreground="{StaticResource TextDim}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Bottom" Typography.NumeralAlignment="Tabular"/>
                                                </Grid>

                                                <!-- 3 Shared-Scale Polylines -->
                                                <Polyline x:Name="PolylineDischarge" Stroke="{StaticResource PowerDischarge}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                                <Polyline x:Name="PolylineCharge" Stroke="{StaticResource PowerCharge}" StrokeThickness="2.5" StrokeLineJoin="Round"/>
                                                <Polyline x:Name="PolylineGpu" Stroke="{StaticResource PowerGpu}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- ================================================= -->
                                <!-- 3. HARDWARE RESOURCE LOAD BREAKDOWN               -->
                                <!-- ================================================= -->
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Path Data="{StaticResource GeoIconGpu}" Fill="{StaticResource AccentCyan}"
                                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtHardwareTitle" Text="硬體實測功耗" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                        </StackPanel>

                                        <!-- Battery Hardware Telemetry Row -->
                                        <Border Style="{StaticResource DataRowStyle}" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="240"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource GeoIconVolt}" Fill="{StaticResource AccentCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="LblHwBatteryTelemetry" Text="電池物理狀態 (電壓 / 電流)" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtTelemetrySub" Text="電池驅動 IOCTL 即時電氣感測" Foreground="{StaticResource PowerDischarge}" FontSize="11" Margin="17,1,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtHwTelemetryVal" Grid.Column="1" Text="-- V  |  -- A" Foreground="{StaticResource PowerDischarge}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="8,0" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock x:Name="TxtHwTelemetrySource" Text="Battery class driver" Grid.Column="2" Foreground="{StaticResource TextDim}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Battery Energy & Capacity Row -->
                                        <Border x:Name="RowHwEnergy" Style="{StaticResource DataRowStyle}" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="240"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource GeoIconEnergyWh}" Fill="{StaticResource PowerNeutral}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="LblHwEnergy" Text="電池蓄電量 (Wh)" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtHwEnergySub" Text="電池驅動實測容量" Foreground="{StaticResource PowerNeutral}" FontSize="11" Margin="17,1,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtHwEnergyVal" Grid.Column="1" Text="--" Foreground="{StaticResource PowerNeutral}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="8,0" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock x:Name="TxtHwEnergyRight" Grid.Column="2" Text="--" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                            </Grid>
                                        </Border>

                                        <!-- Windows Power Scheme Row -->
                                        <Border Style="{StaticResource DataRowStyle}" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="240"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource GeoIconPowerPlan}" Fill="{StaticResource AccentCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="LblHwPowerPlan" Text="Windows 運作電源計劃" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtHwPowerPlanSub" Text="PowrProf 電源管理策略" Foreground="{StaticResource PowerNeutral}" FontSize="11" Margin="17,1,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtHwPowerPlanVal" Grid.Column="1" Text="平衡 (Balanced)" Foreground="{StaticResource PowerNeutral}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="8,0"/>
                                                <TextBlock x:Name="TxtHwPowerPlanState" Text="Active scheme" Grid.Column="2" Foreground="{StaticResource TextDim}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Discrete GPU (dGPU) Row -->
                                        <Border Style="{StaticResource DataRowStyle}" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="240"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource GeoIconGpu}" Fill="{StaticResource PowerGpu}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="獨立顯示卡 (dGPU)" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Text="NVIDIA / AMD 獨立圖形處理器" Foreground="{StaticResource PowerGpu}" FontSize="11" Margin="17,1,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="已整合至上方系統架構圖" Grid.Column="1" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center" Margin="8,0"/>
                                                <TextBlock Text="Real-time sensor" Grid.Column="2" Foreground="{StaticResource TextDim}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Concise Sensor Provenance Strip -->
                                        <Border Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoIconInfo}" Fill="{StaticResource TextDim}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="本頁僅顯示硬體感測器實測數值（電池驅動 IOCTL / 獨顯硬體功耗）。未提供感測器之元件不列推估值。"
                                                           FontSize="11" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Live Power Tip Box -->
                                <Border Background="{StaticResource AccentTint}" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoIconSparkle}" Fill="{StaticResource AccentCyan}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                        <TextBlock x:Name="TxtLivePowerTip" Text="即時監測每 1 秒自動更新一次。" FontSize="12" Foreground="{StaticResource TextMain}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: Live Power & Charge/Discharge History -->
                    <TabItem x:Name="TabHistoryLogs" Tag="{StaticResource GeoIconFileReport}" Header=" 即時功耗與充放電歷史紀錄 ">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Action Buttons Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock x:Name="TxtHistoryLogHeader" Text="即時功耗與充放電事件紀錄" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnExportPowerCsv" Tag="{StaticResource GeoIconExport}" Content="匯出 CSV 紀錄" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="12,4" Click="BtnExportPowerCsv_Click"/>
                                    <Button x:Name="BtnClearPowerHistory" Tag="{StaticResource GeoIconRefresh}" Content="清除紀錄" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Click="BtnClearPowerHistory_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- History Event Log ListView -->
                            <Grid Grid.Row="1">
                                <ListView x:Name="LvPowerHistory" Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Foreground="{StaticResource TextMain}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="時間戳記" Width="140" DisplayMemberBinding="{Binding TimestampText}"/>
                                            <GridViewColumn Header="事件類型" Width="100" DisplayMemberBinding="{Binding EventType}"/>
                                            <GridViewColumn Header="放電/充電功率" Width="108" DisplayMemberBinding="{Binding DischargeRateText}"/>
                                            <GridViewColumn Header="電量 (%)" Width="76" DisplayMemberBinding="{Binding BatteryPercentText}"/>
                                            <GridViewColumn Header="電池狀態 (V / A)" Width="124" DisplayMemberBinding="{Binding TelemetryText}"/>
                                            <GridViewColumn Header="CPU 負載" Width="84" DisplayMemberBinding="{Binding CpuUsageText}"/>
                                            <GridViewColumn Header="獨顯負載" Width="84" DisplayMemberBinding="{Binding DgpuUsageText}"/>
                                            <GridViewColumn Header="獨顯功耗" Width="84" DisplayMemberBinding="{Binding DgpuPowerText}"/>
                                            <GridViewColumn Header="詳細狀態記錄" Width="220" DisplayMemberBinding="{Binding SummaryText}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock x:Name="TxtPowerHistoryEmpty" Text="監測開始後，功耗事件會顯示在這裡。"
                                           Foreground="{StaticResource TextDim}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=LvPowerHistory, Path=HasItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 3: Battery Voltage by State of Charge (0-100%) -->
                    <TabItem x:Name="TabVoltageHistory" Tag="{StaticResource GeoIconVolt}" Header=" 電池電壓紀錄 ">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="270"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,7">
                                <StackPanel>
                                    <TextBlock x:Name="TxtVoltageHistoryTitle" Text="電池電壓紀錄 (0-100%)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock x:Name="TxtVoltageHistorySummary" Text="已記錄 0 / 101 個電量區間，累積 0 次電量變化事件" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="TxtVoltageHistoryHint" Text="僅顯示電池驅動回報的實測電壓；同一電量未變化時不重複記錄。" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnClearVoltageHistory" Tag="{StaticResource GeoIconRefresh}" Content="清除電壓紀錄" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,4" Click="BtnClearVoltageHistory_Click"/>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource MetricCardStyle}" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource DataSurfaceStyle}" ClipToBounds="True">
                                        <Grid x:Name="GridVoltageChartContainer" SizeChanged="GridVoltageChartContainer_SizeChanged">
                                            <Canvas x:Name="CanvasVoltageGridlines"/>

                                            <Grid VerticalAlignment="Stretch" HorizontalAlignment="Left" Margin="8,4,0,4" IsHitTestVisible="False">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="TxtVoltageYAxis100" Grid.Row="0" Text="-- V" FontSize="10" Foreground="{StaticResource TextDim}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Top" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock x:Name="TxtVoltageYAxis75" Grid.Row="1" Text="-- V" FontSize="10" Foreground="{StaticResource TextDim}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Top" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock x:Name="TxtVoltageYAxis50" Grid.Row="2" Text="-- V" FontSize="10" Foreground="{StaticResource TextDim}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Top" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock x:Name="TxtVoltageYAxis25" Grid.Row="3" Text="-- V" FontSize="10" Foreground="{StaticResource TextDim}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Top" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock x:Name="TxtVoltageYAxis0" Grid.Row="4" Text="-- V" FontSize="10" Foreground="{StaticResource TextDim}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Bottom" Typography.NumeralAlignment="Tabular"/>
                                            </Grid>

                                            <!-- Segments are split at missing percentages -->
                                            <Canvas x:Name="CanvasVoltageLines" IsHitTestVisible="False"/>
                                            <Canvas x:Name="CanvasVoltageMarkers" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" Margin="44,3,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.5*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="0.5*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="0%" Grid.Column="0" FontSize="10" Foreground="{StaticResource TextDim}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="25%" Grid.Column="1" FontSize="10" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="50%" Grid.Column="2" FontSize="10" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="75%" Grid.Column="3" FontSize="10" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="100%" Grid.Column="4" FontSize="10" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <ListView x:Name="LvBatteryVoltageHistory" Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Foreground="{StaticResource TextMain}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn x:Name="VoltagePercentColumn" Header="電量 (%)" Width="100" DisplayMemberBinding="{Binding BatteryPercentText}"/>
                                            <GridViewColumn x:Name="VoltageAverageColumn" Header="平均電壓" Width="120" DisplayMemberBinding="{Binding AverageVoltageText}"/>
                                            <GridViewColumn x:Name="VoltageRangeColumn" Header="實測範圍" Width="150" DisplayMemberBinding="{Binding VoltageRangeText}"/>
                                            <GridViewColumn x:Name="VoltageSamplesColumn" Header="變化次數" Width="100" DisplayMemberBinding="{Binding SampleCount}"/>
                                            <GridViewColumn x:Name="VoltageLastColumn" Header="最後紀錄" Width="170" DisplayMemberBinding="{Binding LastRecordedAtText}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock x:Name="TxtVoltageHistoryEmpty" Text="電量百分比改變且驅動回報實測電壓後，紀錄會顯示在這裡。"
                                           Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=LvBatteryVoltageHistory, Path=HasItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 4: Smart Diagnostics -->
                    <TabItem x:Name="TabDiagnostics" Tag="{StaticResource GeoIconShieldCheck}" Header=" 智慧診斷與維護建議 ">
                        <Grid Margin="0,8,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="IcDiagnostics">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgRaised}" CornerRadius="6" Padding="12,10" Margin="0,0,0,7" BorderBrush="{StaticResource AccentCyan}" BorderThickness="3,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextMain}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="TxtDiagnosticsEmpty" Text="執行電池檢測後，診斷與維護建議會顯示在這裡。"
                                       Foreground="{StaticResource TextDim}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=IcDiagnostics, Path=HasItems}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>

                    <!-- TAB 5: Life Estimates -->
                    <TabItem x:Name="TabLifeEstimates" Tag="{StaticResource GeoIconClock}" Header=" 續航估算表 ">
                        <Grid Margin="0,8,0,0">
                            <ListView x:Name="LvLifeEstimates" Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Foreground="{StaticResource TextMain}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="記錄期間" Width="170" DisplayMemberBinding="{Binding Period}"/>
                                        <GridViewColumn Header="實測滿電續航" Width="170" DisplayMemberBinding="{Binding FullChargeEstimate}"/>
                                        <GridViewColumn Header="原廠設計續航" Width="170" DisplayMemberBinding="{Binding DesignCapEstimate}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock x:Name="TxtLifeEstimatesEmpty" Text="載入含續航資料的電池報告後，估算結果會顯示在這裡。"
                                       Foreground="{StaticResource TextDim}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=LvLifeEstimates, Path=HasItems}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>

                    <!-- TAB 6: Recent Usage -->
                    <TabItem x:Name="TabRecentUsage" Tag="{StaticResource GeoIconChart}" Header=" 最近使用紀錄 ">
                        <Grid Margin="0,8,0,0">
                            <ListView x:Name="LvRecentUsage" Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Foreground="{StaticResource TextMain}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="開始時間" Width="170" DisplayMemberBinding="{Binding StartTime}"/>
                                        <GridViewColumn Header="狀態" Width="110" DisplayMemberBinding="{Binding State}"/>
                                        <GridViewColumn Header="電源來源" Width="110" DisplayMemberBinding="{Binding Source}"/>
                                        <GridViewColumn Header="剩餘電量" Width="130" DisplayMemberBinding="{Binding CapacityRemaining}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock x:Name="TxtRecentUsageEmpty" Text="載入含使用紀錄的電池報告後，資料會顯示在這裡。"
                                       Foreground="{StaticResource TextDim}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=LvRecentUsage, Path=HasItems}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Border x:Name="OverlayLoading" Grid.RowSpan="2" Background="#E60A0E13" Visibility="Collapsed">
            <Border Style="{StaticResource PanelCardStyle}" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="50" Height="50" Margin="0,0,0,14">
                        <Ellipse Width="46" Height="46" Stroke="{StaticResource BgControl}" StrokeThickness="4"/>
                        <Ellipse Width="46" Height="46" Stroke="{StaticResource AccentCyan}" StrokeThickness="4" StrokeDashArray="24,100" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Path Data="{StaticResource GeoIconBolt}" Fill="{StaticResource AccentCyan}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="TxtLoadingTitle" Text="正在執行 Windows 電池健康檢測" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtLoadingDetail" Text="powercfg /batteryreport 正在產生並分析最新報告。" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
