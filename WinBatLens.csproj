<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <Title>WinBat Lens - Windows 電池健康度分析診斷工具</Title>
    <Authors>WinBat Lens Team</Authors>
    <Company>WinBat Lens</Company>
    <Product>WinBat Lens</Product>
    <Description>Windows 電池健康度視覺化儀表板與 powercfg /batteryreport 解析工具</Description>
    <Version>1.0.6</Version>
    <AssemblyVersion>1.0.6.0</AssemblyVersion>
    <FileVersion>1.0.6.0</FileVersion>

    <!-- Memory tuning for a long-running background tray app -->
    <!-- Workstation (non-server) GC keeps a single small heap instead of one per CPU core -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Disable the background GC thread; a low-throughput UI app doesn't need it -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Trim the managed heap and return memory to the OS more aggressively -->
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>

    <!-- Single-File Standalone Self-Extracting Packaging Flags -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Startup speed: ReadyToRun AOT-precompiles the IL so most cold-start
         JIT is skipped. Measured on this machine (warm start to first paint):
         no R2R + compressed 69 MB / ~409 ms; R2R + compressed 73 MB / ~373 ms;
         R2R uncompressed 171 MB / ~350 ms. Compression stays ON — dropping it
         buys ~23 ms for +98 MB, which is not worth it. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Real hardware sensors (CPU package power via RAPL, GPU power via NVML/ADL).
         Pulls System.Management >= 10.0.2, so ours is pinned to match. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- GC heap-hardening (0-9): favours a smaller working set over raw speed,
         appropriate for a monitor that mostly sits idle in the system tray. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" Trim="false" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app_icon.ico" />
    <Resource Include="app_icon.png" />
  </ItemGroup>

</Project>
