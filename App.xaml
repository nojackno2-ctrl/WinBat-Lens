             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinBatLens"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <local:HealthGradeBrushConverter x:Key="HealthGradeBrush"/>

            <!-- ============================================================ -->
            <!-- 1. Instrument-Dark Color Palette & Design Tokens              -->
            <!-- ============================================================ -->
            <SolidColorBrush x:Key="BgDark" Color="#070A0E"/>
