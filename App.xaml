            <!-- Gradients for Instrument Surfaces -->
            <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#121B26" Offset="0"/>
                <GradientStop Color="#0D131C" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HeroCardGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#131D2A" Offset="0"/>
                <GradientStop Color="#0C121B" Offset="0.6"/>
                <GradientStop Color="#0F1722" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentButtonGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#38BDF8" Offset="0"/>
                <GradientStop Color="#0284C7" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentButtonHoverGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#7DD3FC" Offset="0"/>
                <GradientStop Color="#38BDF8" Offset="1"/>
            </LinearGradientBrush>

            <!-- Oscilloscope Waveform Area Gradient Brushes -->
            <LinearGradientBrush x:Key="WaveformDischargeAreaGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#38FB7185" Offset="0"/>
                <GradientStop Color="#05FB7185" Offset="0.85"/>
                <GradientStop Color="#00FB7185" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="WaveformChargeAreaGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3834D399" Offset="0"/>
                <GradientStop Color="#0534D399" Offset="0.85"/>
                <GradientStop Color="#0034D399" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="WaveformGpuAreaGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3860A5FA" Offset="0"/>
                <GradientStop Color="#0560A5FA" Offset="0.85"/>
                <GradientStop Color="#0060A5FA" Offset="1"/>
            </LinearGradientBrush>

            <!-- Capacity Loss Striped Hatch Brush -->
            <DrawingBrush x:Key="LossHatchBrush" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#35FB7185">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,8,8"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#B0FB7185" Thickness="1.5"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <LineGeometry StartPoint="0,8" EndPoint="8,0"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

